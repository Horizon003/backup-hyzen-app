// Merge these match blocks into the existing deployed rules; do not replace
// production rules using this standalone emulator policy.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /studyUsers/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /campusMemberships/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    // Access only through authenticated callable readCampusBoard. It checks
    // current verification/opt-out for caller and every returned row.
    match /campusLeaderboards/{document=**} {
      allow read, write: if false;
    }
  }
}
